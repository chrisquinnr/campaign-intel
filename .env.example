# magi-sent environment variables.
# Copy to .env and fill in. .env is gitignored.

# ─── Supabase (data layer) ─────────────────────────────────────
# Project: magi-sent (eu-west-1, postgres 17)
# Dashboard: https://supabase.com/dashboard/project/yefoofucailpzrasmzeh
SUPABASE_URL=https://yefoofucailpzrasmzeh.supabase.co

# Publishable / anon key. Safe in client code if you ever ship browser-side
# Supabase calls. Find under Project Settings → API.
SUPABASE_ANON_KEY=

# Service-role key. Bypasses RLS — server-side only, never expose.
# Find under Project Settings → API → service_role (reveal).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic (lens agents + conscience) ──────────────────────
ANTHROPIC_API_KEY=
# Optional model override for the lens agents; defaults to claude-sonnet-4-6
# in src/lib/server/claude.ts. Haiku 4.5 is hardcoded for the classifier.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Haiku rate limit (requests per minute). Defaults to 45 (10% margin under
# Tier 1's 50 RPM). Bump if you're on a higher tier.
# ANTHROPIC_HAIKU_RPM=45

# ─── Embeddings (phase 1) ──────────────────────────────────────
# OpenAI text-embedding-3-small. Phase 1 only — no other OpenAI calls.
OPENAI_API_KEY=
